# ===========================================================================
# SEGREDOS, CHAVES DE API E VARIAVEIS DE AMBIENTE  (nunca versionar)
# ===========================================================================

# arquivos .env — o .env.example continua versionado de proposito (so placeholders)
.env
.env.*
*.env
*.env.*
!.env.example
back-end/.env
backend/.env
.envrc
# As chaves de IA (CLAUDE_API_KEY) e as de noticia (GNEWS_API_KEY,
# MARKETAUX_API_KEY) vivem apenas em back-end/.env, coberto pelas regras acima:
# nenhum arquivo de segredo delas e versionado com o projeto. O frontend nunca
# recebe essas chaves — quem fala com as APIs e o backend (/api/noticias).

# configuracoes locais de teste/customizacao (costumam trazer chave dentro)
*.local.js
*.local.json
*.local.mjs

# certificados e chaves criptograficas
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.ppk
id_rsa*
id_ed25519*
id_ecdsa*

# arquivos de chaves/credenciais. Evito o glob amplo "*keys*" (ignoraria
# tambem um arquivo de codigo legitimo) e cubro as extensoes de dados/config:
keys.py
key.py
*keys*.json
*keys*.py
*keys*.txt
*keys*.yaml
*keys*.yml
*apikeys*
*api_keys*
*credentials*.json
*credential*.yaml
*credential*.yml
*serviceaccount*.json
*service-account*.json
*secret*.json
*secret*.yaml
*secret*.yml
secrets.toml
.streamlit/secrets.toml

# configuracoes locais de ferramentas (costumam guardar tokens)
.npmrc
.pypirc
netrc
.netrc
.auth/
.aws/
.gcloud/
kubeconfig
# link local do projeto na Vercel (projectId/orgId da sua maquina)
.vercel/

# ===========================================================================
# AGENTE/FERRAMENTA LOCAL (logs de preview e metadados de sessao)
# ===========================================================================

# .freebuff/ guarda logs do preview e o id do projeto da ferramenta local —
# nao e codigo do site e nao deve ser versionado nem publicado.
.freebuff/
# variante com um "f" a menos, para o diretorio nao escapar por causa do nome
.freebuf/

# ===========================================================================
# TOKENS E CHAVES LOCAIS (fora do .env tambem precisam ficar ocultos)
# ===========================================================================

*.token
*.tokens
*token*.json
*token*.txt
tokens.json
.tokens/
tokens/

# ===========================================================================
# ESTADO DE EXECUCAO DO AGENTE (uso e memoria por usuario)
# ===========================================================================

# contador de cota diaria do Gemini
back-end/uso_gemini.json*
# estado dos provedores de IA (quem esta em cooldown) — so runtime
back-end/estado_ias.json*
# contador de cota dos demais provedores (Gemini reservas, Mistral, Cloudflare, OpenRouter)
back-end/uso_ias.json*
# PNGs dos graficos: saida de execucao (em producao nascem em /tmp e saem por
# /api/graficos/<arquivo>), nunca codigo do projeto
back-end/static/graficos/*.png
# memoria por usuario: contem informacoes pessoais ditas no chat
back-end/memoria*.json
memoria*.json

# ===========================================================================
# AMBIENTES VIRTUAIS
# ===========================================================================

venv/
.venv/
env/
ENV/

# ===========================================================================
# CACHE DE PYTHON E FERRAMENTAS
# ===========================================================================

__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ===========================================================================
# ARQUIVOS DO SISTEMA / IDE
# ===========================================================================

.DS_Store
Thumbs.db
.vscode/
.idea/

# ===========================================================================
# LOGS E SAIDAS LOCAIS
# ===========================================================================

*.log
