# Copie este arquivo para "back-end/.env" e preencha com as suas chaves.
# O .env nunca deve ser versionado (já está no .gitignore).

# --- Claude (Anthropic): ÚLTIMA tentativa da rotação (último recurso) ---
# As chaves ficam aqui (nunca no código), porque este arquivo .env é ignorado pelo
# Git. Em produção, defina estas variáveis no painel da Vercel
# (Settings -> Environment Variables), que também não versiona nada.
CLAUDE_API_KEY=coloque_sua_chave_claude_aqui
# opcional: troca o modelo (padrão claude-sonnet-5). Alternativas vistas nesta
# conta: claude-opus-5, claude-haiku-4-5, claude-sonnet-4-5-20250929.
# Para ver a lista atual: python back-end/testar_apis.py --modelos
#CLAUDE_MODEL=claude-sonnet-5

# --- Demais IAs da rotação (reserva, na ordem da cadeia) ---
# A cadeia é Gemini (principal e reservas) -> Mistral -> Cloudflare -> OpenRouter
# -> Claude, e cada provedor só é acionado quando o anterior não consegue
# responder. Chave vazia aqui apenas deixa aquele provedor fora da cadeia; para
# desligar um provedor que TEM chave, remova o identificador dele de
# PROVEDORES_IA_AUTORIZADOS (back-end/app.py).
GEMINI_API_KEY=coloque_sua_chave_gemini_aqui
GEMINI_API_KEY_2=chave_gemini_reserva_1
GEMINI_API_KEY_3=chave_gemini_reserva_2
# opcional: modelo chamado pelas duas chaves de RESERVA (padrão gemini-2.5-flash-lite)
#GEMINI_MODEL_RESERVA=gemini-2.5-flash-lite
MISTRAL_API_KEY=coloque_sua_chave_mistral_aqui
# opcional: troca o modelo da Mistral (padrão mistral-small-latest)
#MISTRAL_MODEL=mistral-small-latest
OPENROUTER_API_KEY=chave_openrouter
# opcional: teto diário considerado nos modelos gratuitos (padrão 50)
#OPENROUTER_LIMITE_DIARIO=50

# --- Cloudflare Workers AI (rotação) ---
# O token e o account id andam juntos: sem os dois o provedor fica desativado.
# Crie em dash.cloudflare.com -> My Profile -> API Tokens (permissão Workers AI)
# e veja o Account ID na mesma página ou na URL do dashboard.
CLOUDFLARE_API_TOKEN=coloque_seu_token_cloudflare_aqui
CLOUDFLARE_ACCOUNT_ID=coloque_seu_account_id_aqui
# opcional: troca o modelo (padrão @cf/meta/llama-3.1-8b-instruct)
#CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct

# --- Notícias de mercado (GNews + Marketaux) ---
# Lidas SOMENTE pelo backend, na rota GET /api/noticias: o backend consulta as duas
# APIs e devolve o resultado unificado, então a chave nunca chega ao navegador.
# Crie as suas em gnews.io e marketaux.com.
GNEWS_API_KEY=coloque_sua_chave_gnews_aqui
MARKETAUX_API_KEY=coloque_sua_chave_marketaux_aqui

# --- Fontes de dados de mercado em tempo real ---
HGBRASIL_API_KEY=chave_hg_brasil
FINNHUB_API_KEY=chave_finnhub
TWELVE_DATA_API_KEY=chave_twelve_data
